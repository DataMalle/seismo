# Klistras in i Streamlit Community Cloud > App settings > Secrets. Checka ALDRIG in riktiga värden.
DATABRICKS_HOST = "https://<workspace>.cloud.databricks.com"
DATABRICKS_CLIENT_ID = "<read-only service principal application id>"
DATABRICKS_CLIENT_SECRET = "<oauth secret>"
DATABRICKS_WAREHOUSE_ID = "<warehouse id>"
CATALOG = "workspace"
SCHEMA_PREFIX = "seismo"
